-4: var(--blue-4);\n  --color-accent-5: var(--blue-5);\n  --color-accent-6: var(--blue-6);\n  --color-accent-7: var(--blue-7);\n  --color-accent-8: var(--blue-8);\n  --color-accent-9: var(--blue-9);\n  --color-accent-10: var(--blue-10);\n  --color-accent-11: var(--blue-11);\n  --color-accent-12: var(--blue-12);\n  --color-accent-contrast: var(--blue-contrast);\n\n  /* Error colors - Warm amber for warnings */\n  --color-error-1: var(--amber-1);\n  --color-error-2: var(--amber-2);\n  --color-error-3: var(--amber-3);\n  --color-error-4: var(--amber-4);\n  --color-error-5: var(--amber-5);\n  --color-error-6: var(--amber-6);\n  --color-error-7: var(--amber-7);\n  --color-error-8: var(--amber-8);\n  --color-error-9: var(--amber-9);\n  --color-error-10: var(--amber-10);\n  --color-error-11: var(--amber-11);\n  --color-error-12: var(--amber-12);\n  --color-error-contrast: var(--amber-contrast);\n\n  /* Success colors - Vibrant green for confirmations */\n  --color-success-1: var(--green-1);\n  --color-success-2: var(--green-2);\n  --color-success-3: var(--green-3);\n  --color-success-4: var(--green-4);\n  --color-success-5: var(--green-5);\n  --color-success-6: var(--green-6);\n  --color-success-7: var(--green-7);\n  --color-success-8: var(--green-8);\n  --color-success-9: var(--green-9);\n  --color-success-10: var(--green-10);\n  --color-success-11: var(--green-11);\n  --color-success-12: var(--green-12);\n  --color-success-contrast: var(--green-contrast);\n}\n"],["STYLE",{},"/* Tabbed navigation styles */\n._tabs_q53am_2 {\n  display: flex;\n  gap: 0;\n  border-bottom: 2px solid var(--color-neutral-6);\n  margin-bottom: var(--space-4);\n}\n\n._tab_q53am_2 {\n  background: var(--color-neutral-2);\n  color: var(--color-neutral-10);\n  border: 1px solid var(--color-neutral-6);\n  border-bottom: none;\n  border-radius: var(--radius-4) var(--radius-4) 0 0;\n  padding: 10px 24px;\n  font: var(--font-heading);\n  font-size: var(--font-size-2);\n  cursor: pointer;\n  transition: background 0.2s, color 0.2s;\n  margin-right: 2px;\n  outline: none;\n}\n\n._tab_q53am_2:not(:last-child) {\n  margin-right: 2px;\n}\n\n._tab_q53am_2:hover {\n  background: var(--color-neutral-3);\n  color: var(--color-neutral-12);\n}\n\n._activeTab_q53am_33 {\n  background: var(--color-neutral-1);\n  color: var(--color-primary-10);\n  border: 2px solid var(--color-primary-7);\n  border-bottom: none;\n  border-radius: var(--radius-4) var(--radius-4) 0 0;\n  padding: 12px 26px;\n  font: var(--font-heading);\n  font-size: var(--font-size-2);\n  cursor: pointer;\n  z-index: 2;\n  position: relative;\n}\n\n._tabPanel_q53am_47 {\n  background: var(--color-neutral-2);\n  border-radius: 0 0 var(--radius-4) var(--radius-4);\n  border: 1px solid var(--color-neutral-6);\n  border-top: none;\n  padding: var(--space-5);\n}\n._container_q53am_54 {\n  min-height: 100vh;\n  background: var(--color-neutral-1);\n  padding: var(--space-6);\n}\n\n._header_q53am_60 {\n  margin-bottom: var(--space-6);\n}\n\n._title_q53am_64 {\n  font: calc(0.3 * var(--font-display));\n  color: var(--color-neutral-12);\n  margin: 0 0 var(--space-2) 0;\n  letter-spacing: -0.02em;\n}\n\n._subtitle_q53am_71 {\n  font: var(--font-body);\n  color: var(--color-neutral-11);\n  margin: 0;\n}\n\n._workspace_q53am_77 {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  grid-template-rows: repeat(2, 1fr);\n  gap: var(--space-5);\n  align-items: start;\n  height: calc(100vh - 200px);\n}\n\n._panel_q53am_86 {\n  background: var(--color-neutral-2);\n  border-radius: var(--radius-4);\n  padding: var(--space-5);\n  border: 1px solid var(--color-neutral-5);\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-4);\n  min-height: 600px;\n}\n\n._panelHeader_q53am_97 {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding-bottom: var(--space-3);\n  border-bottom: 1px solid var(--color-neutral-6);\n}\n\n._panelTitle_q53am_105 {\n  font: var(--font-heading);\n  color: 