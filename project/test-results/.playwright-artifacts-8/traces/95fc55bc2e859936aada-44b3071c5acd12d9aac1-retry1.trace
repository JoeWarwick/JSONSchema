}\n\n._tabPanel_q53am_47 {\n  background: var(--color-neutral-2);\n  border-radius: 0 0 var(--radius-4) var(--radius-4);\n  border: 1px solid var(--color-neutral-6);\n  border-top: none;\n  padding: var(--space-5);\n}\n._container_q53am_54 {\n  min-height: 100vh;\n  background: var(--color-neutral-1);\n  padding: var(--space-6);\n}\n\n._header_q53am_60 {\n  margin-bottom: var(--space-6);\n}\n\n._title_q53am_64 {\n  font: calc(0.3 * var(--font-display));\n  color: var(--color-neutral-12);\n  margin: 0 0 var(--space-2) 0;\n  letter-spacing: -0.02em;\n}\n\n._subtitle_q53am_71 {\n  font: var(--font-body);\n  color: var(--color-neutral-11);\n  margin: 0;\n}\n\n._workspace_q53am_77 {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  grid-template-rows: repeat(2, 1fr);\n  gap: var(--space-5);\n  align-items: start;\n  height: calc(100vh - 200px);\n}\n\n._panel_q53am_86 {\n  background: var(--color-neutral-2);\n  border-radius: var(--radius-4);\n  padding: var(--space-5);\n  border: 1px solid var(--color-neutral-5);\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-4);\n  min-height: 600px;\n}\n\n._panelHeader_q53am_97 {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding-bottom: var(--space-3);\n  border-bottom: 1px solid var(--color-neutral-6);\n}\n\n._panelTitle_q53am_105 {\n  font: var(--font-heading);\n  color: var(--color-neutral-12);\n  margin: 0;\n  font-size: var(--font-size-3);\n}\n\n._inputControls_q53am_112 {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-3);\n}\n\n._urlInputGroup_q53am_118 {\n  display: flex;\n  gap: var(--space-2);\n}\n\n._urlInput_q53am_118 {\n  flex: 1;\n  padding: var(--space-2) var(--space-3);\n  background: var(--color-neutral-1);\n  border: 1px solid var(--color-neutral-6);\n  border-radius: var(--radius-3);\n  color: var(--color-neutral-12);\n  font: var(--font-body);\n  font-size: var(--font-size-1);\n  transition: border-color 0.2s var(--ease);\n}\n\n._u